{
  "manifest_version": 3,
  "name": "Hexactra AI",
  "version": "0.1.0",
  "description": "AI-powered browser automation assistant - Native messaging bridge and managed browser worker",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Hexactra AI",
    "default_popup": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "native_manifests": {
    "com.hexactra.nativehost": {
      "allowed_origins": [
        "chrome-extension://YOUR_EXTENSION_ID_HERE/"
      ]
    }
  }
}
