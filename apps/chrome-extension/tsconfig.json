{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/dist/**"]
}
