<?xml version="1.0" encoding="utf-8"?>
<!-- hexactra brand tokens (docs/brand/README.md) that identity.json does not carry.
     brand_primary, brand_background and ic_launcher_background are generated from
     packages/shared/identity.json by the build; never redefine them here. -->
<resources>
    <!-- The web app bar's colour (palette.background.paper): the status bar matches it. -->
    <color name="brand_surface">#FFFFFFFF</color>
    <color name="brand_danger">#FFC2412A</color>

    <!-- Dark scheme: the TWA's *_DARK metadata and values-night/themes.xml. -->
    <color name="brand_night_primary">#FF8C8CFF</color>
    <color name="brand_night_background">#FF0D0E17</color>
    <color name="brand_night_surface">#FF181A28</color>
</resources>
