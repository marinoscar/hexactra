{
  "name": "api",
  "version": "1.126.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./test/jest.config.js --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:db": "jest --config ./test/jest.config.js --testRegex '\\.db\\.spec\\.ts$' --runInBand",
    "prisma": "node scripts/prisma-env.js",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "prisma:validate": "node scripts/prisma-env.js validate",
    "prisma:migrate": "node scripts/prisma-env.js migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma-env.js migrate dev",
    "prisma:seed": "node scripts/prisma-env.js db seed",
    "seed:runs": "ts-node --transpile-only scripts/seed-runs.ts",
    "scenarios": "ts-node --transpile-only scripts/scenarios.ts",
    "scenarios:schema": "ts-node --transpile-only scripts/scenarios.ts --write-schema",
    "scenarios:live": "ts-node --transpile-only scripts/scenarios-live.ts",
    "db:compose": "platform db compose",
    "db:compose:check": "platform db compose --check",
    "db:sync": "platform db sync",
    "db:check": "platform db check && vault-db check",
    "db:vault:sync": "vault-db sync --names after-host"
  },
  "dependencies": {
    "@app/shared": "*",
    "@fastify/cookie": "~11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@marinoscar/hexactra-agent": "0.1.0-next.0",
    "@marinoscar/hexactra-browser-agent": "0.1.0-next.0",
    "@marinoscar/platform-api": "^0.1.0-next.39",
    "@marinoscar/platform-contract": "^0.1.0-next.39",
    "@marinoscar/platform-db": "^0.1.0-next.39",
    "@marinoscar/vault-api": "0.1.0-next.4",
    "@marinoscar/vault-contract": "0.1.0-next.4",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "ajv": "^8.18.0",
    "cron": "^4.4.0",
    "fastify": "^5",
    "jpeg-js": "^0.4.4",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "pdfmake": "^0.3.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tldts": "^7.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@marinoscar/vault-db": "0.1.0-next.4",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.12",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unpdf": "^2.2.1"
  }
}
