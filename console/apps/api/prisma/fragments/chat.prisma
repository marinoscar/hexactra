// Chat (#482, #483): a conversation is a thread in which the owner asks for
// something and the agent answers; a job a chat starts is an ordinary Run
// (`runs.conversation_id`, trigger `chat`). Messages NEVER hold a secret: a
// credential the agent asks for goes to the fabric handoff, not to this table.
// Registered in the user-owned data registry (src/chat/chat.ownership.ts).

enum ConversationStatus {
  active
  archived

  @@map("conversation_status")
}

enum ChatMessageRole {
  user
  assistant
  system

  @@map("chat_message_role")
}

/// What a message is, so the thread can render it: plain text, a clarifying
/// question (`meta.options` are its chips), the card of a run, a run's result,
/// a drafted task, or a proposed memory (#553).
enum ChatMessageKind {
  text
  clarify
  run
  result
  task_draft
  /// The agent proposes a memory (#553): `meta.questionId` is the proposal, answered on its card.
  memory
  /// A request a chat's run made of the owner (E40.1, #685): `meta.questionId`; the outcome is read from the question, never a value.
  request

  @@map("chat_message_kind")
}

/// What a conversation is for (E42.1, #718): an ordinary chat, or the task
/// builder, which interviews the owner and drafts a task (it never starts a
/// run and never appears in the chat list).
enum ConversationMode {
  chat
  task_builder

  @@map("conversation_mode")
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  mode          ConversationMode   @default(chat)
  /// The task builder's live task spec (`taskBuilderSpecSchema`, src/task-builder/): null for a chat. Never a secret.
  builderSpec   Json?              @map("builder_spec")
  /// Empty until the first message names it (or the owner does).
  title         String             @default("") @db.VarChar(200)
  status        ConversationStatus @default(active)
  /// Where and how the chat's runs execute: the same settings a task has.
  profile       String             @default("default") @db.VarChar(32)
  hostId        String?            @map("host_id") @db.Uuid
  hostFallback  Boolean            @default(true) @map("host_fallback")
  /// Agent policy for the chat's runs: a UUID or `builtin:<key>`; null is the user's default.
  policyRef     String?            @map("policy_ref") @db.VarChar(64)
  /// Opt-in limits of the chat's runs, as on a task: sites the agent may visit (empty: any).
  allowedDomains      String[]     @default([]) @map("allowed_domains")
  /// Ask the owner before a purchase or another step that is hard to undo. On by default in a chat.
  confirmRiskyActions Boolean      @default(true) @map("confirm_risky_actions")
  /// Which of the owner's connections the chat may use (#969): `all` (the default) every active connection at what the owner switched on for
  /// it; `listed` only the `conversation_connections` rows, each at its access.
  connectionsMode String           @default("all") @map("connections_mode") @db.VarChar(8)
  /// Let the chat's runs sign in from the owner's saved logins (E37.3): an opt-in, off by default (new chats start from the owner's `secrets.defaultUseSavedLogins`).
  useSavedLogins Boolean           @default(false) @map("use_saved_logins")
  /// Let the chat's runs fill identity details from the owner's saved details (E37.6): off by default.
  useSavedIdentity Boolean         @default(false) @map("use_saved_identity")
  /// Let the chat's runs pay with a saved card (E37.7): off by default.
  useSavedCards Boolean            @default(false) @map("use_saved_cards")
  /// Record a video of the chat's runs (epic #755, #906): off by default. The video is not masked and is owner-only.
  recordVideo   Boolean            @default(false) @map("record_video")
  /// The highest `seq` of an owner message the turn engine has taken up (#484).
  answeredSeq   Int                @default(0) @map("answered_seq")
  /// Held while a turn is working on this chat, so two turns never run at once; a crashed turn's lease expires.
  turnLeaseUntil DateTime?         @map("turn_lease_until") @db.Timestamptz
  /// The next message's `seq`; bumped in the same statement that reserves it.
  nextSeq       Int                @default(1) @map("next_seq")
  lastMessageAt DateTime           @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  runs     Run[]
  guidance RunGuidance[]
  connections ConversationConnection[]

  /// The chat list: one status, most recent first.
  @@index([userId, status, lastMessageAt])
  /// The chat list reads one mode.
  @@index([userId, mode, status, lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  /// Order within the conversation, from 1.
  seq            Int
  role           ChatMessageRole
  kind           ChatMessageKind @default(text)
  text           String          @default("") @db.VarChar(8000)
  /// The run a `run` or `result` message is about.
  runId          String?         @map("run_id") @db.Uuid
  /// Kind-specific data (`{ options }` of a clarify, the draft of a task_draft). Never a secret.
  meta           Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([conversationId, seq])
  @@index([runId])
  @@map("chat_messages")
}

extend model User {
  conversations Conversation[]
}

/// A line the owner typed while a chat's run was working (#490): the runner
/// reads the pending ones at its next chunk and marks them delivered. Guidance
/// is advice to the agent, never an authorization, and never a secret.
model RunGuidance {
  id             String    @id @default(uuid()) @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  /// The owner message it came from, so the thread can show "Queued" or "Seen by the agent" under it.
  messageSeq     Int       @map("message_seq")
  note           String    @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz

  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([runId, deliveredAt])
  @@index([conversationId])
  @@map("run_guidance")
}
