// Connected AI apps (#464): what the owner allows each OAuth client (ChatGPT,
// Claude, ...) to do with their Hexactra account, on top of the scopes of its
// consent. One row per (user, client), created lazily the first time the
// settings are read or changed, or the app connects. A limit only ever
// narrows: it never widens a task's own opt-ins. Usage (runs, spend) is not
// stored: it is counted from `runs` (index `runs(user_id, client_id, created_at)`).
// Registered in the user-owned data registry (src/connected-apps/connected-apps.ownership.ts).

model ConnectedAppSettings {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// `oauth_clients.id`. No foreign key: the row is the user's, and outlives an administrator removing the client.
  clientId          String   @map("client_id") @db.Uuid
  /// The agent policy this app's runs use when the call names none (an own policy's UUID or `builtin:<key>`); null: the user's default.
  policyId          String?  @map("policy_id") @db.VarChar(64)
  /// The only policies this app may choose; empty: any.
  allowedPolicyIds  String[] @default([]) @map("allowed_policy_ids")
  /// Sites this app's runs and browser sessions may visit (suffix match), intersected with the task's own; empty: no extra limit.
  allowedDomains    String[] @default([]) @map("allowed_domains")
  /// Live runs and sessions this app may have at once.
  maxConcurrentRuns Int      @default(2) @map("max_concurrent_runs")
  /// Runs and sessions per day (the user's profile time zone).
  dailyRunLimit     Int      @default(50) @map("daily_run_limit")
  /// USD per day over this app's runs; null: no cost limit.
  dailyCostLimitUsd Decimal? @map("daily_cost_limit_usd") @db.Decimal(10, 2)
  /// Ask before risky steps (purchases, submissions) on this app's runs even when the task does not.
  confirmPurchases  Boolean  @default(true) @map("confirm_purchases")
  /// Ask the user (a high-risk confirm in the console) before this app's sensitive browser actions (#465): secrets, payment and password forms, sensitive hosts, the desktop, network-reaching JavaScript.
  confirmSensitiveActions Boolean @default(true) @map("confirm_sensitive_actions")
  /// Let this app's runs sign in from the owner's saved logins (E37.3). Off by default: an AI app never gets the owner's logins unless the owner allows it here.
  allowSavedLogins  Boolean  @default(false) @map("allow_saved_logins")
  /// Let this app's runs fill identity details from the owner's saved details (E37.6). Off by default; needs `allowSavedLogins`.
  allowSavedIdentity Boolean @default(false) @map("allow_saved_identity")
  /// Let this app's runs pay with the owner's saved cards (E37.7). Off by default; needs `allowSavedLogins`, and its "confirm purchases" limit still applies.
  allowSavedCards Boolean @default(false) @map("allow_saved_cards")
  /// Let this app's runs use the connections the owner switched on (E39.7). On by default for a new app (E50.17); a stored value is kept.
  allowConnections Boolean @default(true) @map("allow_connections")
  /// Let this app's runs use web search (E50.7) when the owner set it up and switched it on. On by default.
  allowWebSearch  Boolean  @default(true) @map("allow_web_search")
  /// Refuse new runs and sessions from this app without disconnecting it.
  paused            Boolean  @default(false)
  /// The scopes the owner was already told about (`app.connected`, `app.scope_added`), so a step-up announces only what it adds.
  notifiedScopes    String[] @default([]) @map("notified_scopes")
  /// When `app.first_run` was sent for the current connection; null: not yet.
  firstRunAt        DateTime? @map("first_run_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("connected_app_settings")
}

extend model User {
  connectedAppSettings ConnectedAppSettings[]
}
