// Connections (E39.2, #599, epic #581): the owner's accounts at Google and Microsoft (and, later, MCP servers),
// several per service, each with a label the owner chose and its own switches for Mail, Calendar and Documents.
// It holds NO token: the refresh token, the cached access token and the PKCE verifier of a flow in progress live
// in the encrypted per-user credential store (purpose `connection_token`, src/connections/connections.credentials.ts).
// What is stored here is what the owner may read: who the account is, what is switched on, what the provider
// granted, the defaults, the status and the times.
// Registered in the user-owned data registry (src/connections/connections.ownership.ts).

/// `mcp` (E39.9): an MCP server the owner added (Streamable HTTP only). Its URL and how it signs in are in `config`; its tools are
/// `connection_mcp_tools`; its secrets (a bearer token, an OAuth client and tokens) are in the credential store.
enum ConnectionProvider {
  google
  microsoft
  mcp

  @@map("connection_provider")
}

/// `paused`: the owner stopped it; nothing uses it. `needs_reconnect`: the provider refused the saved grant. `revoked`: reserved.
enum ConnectionStatus {
  active
  paused
  needs_reconnect
  revoked

  @@map("connection_status")
}

// @extensible
model Connection {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  provider            ConnectionProvider
  /// The account at the provider: its stable id and what the owner sees.
  accountId           String           @map("account_id") @db.VarChar(255)
  accountEmail        String           @map("account_email") @db.VarChar(320)
  accountName         String?          @map("account_name") @db.VarChar(200)
  /// What the owner calls it: "Work", "Personal".
  label               String           @db.VarChar(60)
  /// Which capabilities are switched on: mail_read, mail_send, calendar_read, calendar_write, docs_read, docs_write.
  capabilities        String[]         @default([])
  /// Permissions the provider actually granted (may exceed or fall short of the switches).
  grantedScopes       String[]         @default([]) @map("granted_scopes")
  /// The default account for each capability group (mail, calendar, docs): at most one per provider and group per user.
  defaultFor          String[]         @default([]) @map("default_for")
  status              ConnectionStatus @default(active)
  /// A stable code (`GRANT_REVOKED`, `TOKEN_STORE_FAILED`, ...), never a message that could carry data.
  statusReason        String?          @map("status_reason") @db.VarChar(60)
  connectedAt         DateTime         @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt          DateTime?        @map("last_used_at") @db.Timestamptz
  lastRefreshAt       DateTime?        @map("last_refresh_at") @db.Timestamptz
  /// When the cached access token stops working. The token itself is in the credential store.
  accessExpiresAt     DateTime?        @map("access_expires_at") @db.Timestamptz
  /// The refresh lease: one refresh at a time per connection (a rotated refresh token must be stored before the old one is dropped).
  refreshLeaseUntil   DateTime?        @map("refresh_lease_until") @db.Timestamptz
  /// When the owner was told this connection needs reconnecting (once per episode; cleared on reconnect).
  reconnectNotifiedAt DateTime?        @map("reconnect_notified_at") @db.Timestamptz
  /// Provider `mcp` only (E39.9): the server's URL, how it signs in (`none`, `bearer`, `header`, `oauth`: never the secret), what it
  /// said about itself and when its tools were last listed. Validated by `mcpConfigSchema` (src/connections/mcp/mcp-config.ts).
  config              Json?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  flows ConnectionFlow[]
  taskConnections         TaskConnection[]
  conversationConnections ConversationConnection[]
  mcpTools                ConnectionMcpTool[]

  @@unique([userId, provider, accountId])
  @@unique([userId, label])
  @@index([userId, provider, status])
  @@index([status, lastRefreshAt])
  @@map("connections")
}

/// A Connect (or an incremental consent) in progress: the SHA-256 of `state` and of the browser-binding cookie, what was
/// asked, and when it expires. Single use: the callback deletes the row before it exchanges the code. The PKCE verifier is
/// in the credential store (`connection_token`, name `flow.<id>`), never here.
model ConnectionFlow {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  provider     ConnectionProvider
  stateHash    String             @unique @map("state_hash") @db.VarChar(64)
  bindingHash  String             @map("binding_hash") @db.VarChar(64)
  /// The capabilities asked for (a new connection) or to add (an incremental consent).
  capabilities String[]           @default([])
  label        String?            @db.VarChar(60)
  loginHint    String?            @map("login_hint") @db.VarChar(320)
  /// Set for an incremental consent: the connection that gains the permissions.
  connectionId String?            @map("connection_id") @db.Uuid
  /// A path on this console the browser returns to.
  returnTo     String             @map("return_to") @db.VarChar(200)
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("connection_flows")
}

/// DEPRECATED (E50.17, #987): no longer read to decide availability and no longer written; a run gets every connection the owner
/// switched on. Kept for one release (data and exports reference it); a follow-up removes it. Was: the connections a task may use (E39.7).
model TaskConnection {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  /// `read` or `read_write`.
  access       String   @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([taskId, connectionId])
  @@index([connectionId])
  @@map("task_connections")
}

/// DEPRECATED (E50.17, #987), like `TaskConnection`: the old per-chat list (E39.7). Not read, not written; removed after one release.
model ConversationConnection {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  access         String   @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([conversationId, connectionId])
  @@index([connectionId])
  @@map("conversation_connections")
}

/// The tools an MCP server offered (E39.9): a snapshot per connection, taken on connect and on "Refresh tools". `mode` is the OWNER's
/// choice (`off` by default, `read` or `write`); `suggested` is only what the server's hints suggest. `hash` covers the name, title,
/// description, input schema and hints: a refresh that finds a different hash for a tool the owner enabled switches it off and sets
/// `review` (`changed`; `new` for a tool that appeared after the first listing) until the owner decides again, which records
/// `approved_hash`. A tool the server stops offering is deleted.
model ConnectionMcpTool {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  name         String   @db.VarChar(128)
  title        String?  @db.VarChar(200)
  /// The server's text, kept as sent up to 4,000 characters: it is shown to the owner as plain text and sanitised before a model reads it.
  description  String   @default("") @db.Text
  inputSchema  Json     @map("input_schema")
  annotations  Json     @default("{}")
  hash         String   @db.VarChar(64)
  /// `off`, `read` or `write`: set only by the owner's own act.
  mode         String   @default("off") @db.VarChar(8)
  /// `read` or `write`: what the hints suggest (no hint: `write`).
  suggested    String   @db.VarChar(8)
  /// `new` or `changed` while the owner has not reviewed it; null once reviewed.
  review       String?  @db.VarChar(8)
  /// The hash the owner last decided on.
  approvedHash String?  @map("approved_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
  @@index([connectionId, mode])
  @@map("connection_mcp_tools")
}

extend model User {
  connections     Connection[]
  connectionFlows ConnectionFlow[]
}
