// Mail triggers (E39.8, #605, epic #581): start a task when a matching email arrives. A trigger belongs to a task and to one of
// the owner's connected accounts; the poller (src/mail-triggers/) reads new mail through the capability interfaces, matches it
// with structured rules (a sender is REQUIRED), and starts one run per matched message.
//
// The message is never stored here: an event row keeps the provider's message id (the dedupe key), the outcome and, for a started
// run, the run id. No subject, address or body is ever written to the database by this feature.
// Registered in the user-owned data registry (src/mail-triggers/mail-triggers.ownership.ts).

model MailTrigger {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  connectionId  String    @map("connection_id") @db.Uuid
  name          String    @db.VarChar(120)
  enabled       Boolean   @default(true)
  /// The structured match: `{ from: [address or @domain], to?, subjectContains?, textContains?, hasAttachment?, label? }`.
  /// `from` is required: a trigger that would match mail from anyone cannot be saved.
  match         Json
  /// How task parameters get their values: `{ [key]: { fixed } | { header } | { capture } }`. Null for none.
  inputs        Json?
  /// What happens to the message after a run was started: `none`, `mark_read` or `add_label:<label id>`.
  afterStart    String    @default("none") @map("after_start") @db.VarChar(80)
  /// The newest message the trigger has seen, as `t1:<ISO instant>`. Opaque to everything but the poller, so push can replace polling
  /// without a schema change. Advanced only after the matched messages were recorded.
  cursor        String?   @db.VarChar(500)
  /// Only messages that arrived after this count: set when the trigger is created and each time it is enabled again.
  activeSince   DateTime  @default(now()) @map("active_since") @db.Timestamptz
  pollSeconds   Int       @default(300) @map("poll_seconds")
  /// Also start for a message whose sender the provider could not check (`unknown`). Off by default: a message must have passed the provider's
  /// SPF, DKIM or DMARC check, and one that failed it never starts a run whatever this says.
  acceptUnverified Boolean @default(false) @map("accept_unverified")
  maxRunsPerDay Int       @default(10) @map("max_runs_per_day")
  /// When the poller looks at this trigger next (spread by a per-trigger offset so many triggers do not poll in the same second).
  nextPollAt    DateTime? @map("next_poll_at") @db.Timestamptz
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz
  lastMatchedAt DateTime? @map("last_matched_at") @db.Timestamptz
  /// `ok`: polling. `needs_reconnect`: the connection must be connected again (the owner was told once). `failing`: the provider kept
  /// failing. `rate_limited`: the provider asked to slow down (the poller backs off). A plain string, not an enum: the set may grow.
  status        String    @default("ok") @db.VarChar(30)
  /// A stable code for `status` (`CONNECTION_NEEDS_RECONNECT`, `PROVIDER_ERROR`, ...), never a provider message.
  statusReason  String?   @map("status_reason") @db.VarChar(60)
  /// Failed polls in a row; `failing` after three.
  consecutiveErrors Int   @default(0) @map("consecutive_errors")
  /// When the owner was told this trigger needs attention (once per episode; cleared when it polls fine again).
  statusNotifiedAt  DateTime? @map("status_notified_at") @db.Timestamptz
  /// Once per day: the day (UTC date) the owner was last told about unverified senders and about the daily limit.
  unverifiedNotifiedOn String? @map("unverified_notified_on") @db.VarChar(10)
  limitNotifiedOn      String? @map("limit_notified_on") @db.VarChar(10)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events MailTriggerEvent[]

  @@index([userId])
  @@index([taskId])
  @@index([connectionId])
  @@index([enabled, nextPollAt])
  @@map("mail_triggers")
}

/// One row per message a trigger acted on or skipped: the dedupe record. `(trigger_id, message_id)` is unique, so a message
/// is acted on once even across retries and restarts. `outcome`: `started`, `skipped_limit`, `skipped_unverified`, `skipped_loop`,
/// `failed`.
model MailTriggerEvent {
  id        String   @id @default(uuid()) @db.Uuid
  triggerId String   @map("trigger_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.VarChar(255)
  runId     String?  @map("run_id") @db.Uuid
  outcome   String   @db.VarChar(30)
  /// A stable code for a skip or a failure (`SENDER_NOT_VERIFIED`, `TRIGGER_DAILY_LIMIT`, `USER_DAILY_LIMIT`, `OWN_MESSAGE`, ...).
  reason    String?  @db.VarChar(60)
  /// When the message arrived (the provider's date), for the lag measure.
  messageAt DateTime? @map("message_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  trigger MailTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([triggerId, messageId])
  @@index([userId, createdAt])
  @@index([triggerId, createdAt])
  @@map("mail_trigger_events")
}

extend model User {
  mailTriggers      MailTrigger[]
  mailTriggerEvents MailTriggerEvent[]
}

extend model Task {
  mailTriggers MailTrigger[]
}
