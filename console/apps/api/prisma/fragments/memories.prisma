// Memories (#551, epic #549): facts the owner lets the agent use: people,
// accounts, preferences and other facts. A memory is data, never an
// instruction and never a permission; it is written only by the owner's own
// act (typed here, or an agent proposal the owner approved, #553). No Secret
// Material: the service refuses passwords, codes, full card, account and
// Social Security numbers (src/memories/memory-secrets.ts).
// Registered in the user-owned data registry (src/memories/memories.ownership.ts).

enum MemoryKind {
  person
  account
  preference
  fact

  @@map("memory_kind")
}

enum MemoryStatus {
  active
  superseded
  archived

  @@map("memory_status")
}

enum MemorySource {
  owner
  agent_proposed

  @@map("memory_source")
}

model Memory {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  kind                 MemoryKind
  /// What the owner calls it: "My wife", "Checking account".
  label                String       @db.VarChar(120)
  /// Other words that mean the same: ["wife", "paula"]. Lower-cased, at most 10.
  aliases              String[]     @default([])
  /// Named values: { "name": "…", "phone": "…" }. At most 20 keys, 500 characters a value.
  attributes           Json
  /// Free text the owner adds. At most 1000 characters.
  note                 String?      @db.VarChar(1000)
  status               MemoryStatus @default(active)
  source               MemorySource
  /// Where an agent-proposed memory came from: plain ids, not foreign keys (deleting a run or chat keeps the memory).
  sourceRunId          String?      @map("source_run_id") @db.Uuid
  sourceConversationId String?      @map("source_conversation_id") @db.Uuid
  /// The newer version that replaced this one.
  supersededById       String?      @map("superseded_by_id") @db.Uuid
  lastUsedAt           DateTime?    @map("last_used_at") @db.Timestamptz
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, kind])
  @@map("memories")
}

extend model User {
  memories Memory[]
}
