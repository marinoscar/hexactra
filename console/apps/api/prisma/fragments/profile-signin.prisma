// Guided Google sign-in of a node's browser profile (E48.4, #930; decision record
// docs/decisions/profile-signin-health.md at the repository root). One row per
// "Sign in" click: the console took over the host's desktop, opened the profile
// at Google's sign-in, and waits for the profile's status to read signed in,
// then closes its browser so Chrome saves the profile, and gives the desktop back.
// The row never holds the account email: the page reads it live from the host's
// profile status. The `fleet.profile-signin.expire` job ends a session that is
// still open 15 minutes after it started, as `abandoned`.

model ProfileSigninSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// The organization the person acted in (null in single-organization mode without one).
  organizationId   String?   @map("organization_id") @db.Uuid
  hostId           String    @map("host_id") @db.Uuid
  profile          String    @db.VarChar(32)
  /// started | completed | abandoned
  status           String    @default("started") @db.VarChar(12)
  /// While started: waiting (for the person to sign in) | saving (the browser was closed; waiting for the offline check).
  phase            String    @default("waiting") @db.VarChar(12)
  /// The fabric takeover lease the session holds (null: none held any more).
  leaseId          String?   @map("lease_id") @db.Uuid
  /// The desktop viewer session the console opened for it.
  viewerSessionId  String?   @map("viewer_session_id") @db.Uuid
  /// Keep the lease and the viewer session when the session ends (a "Fix sign-ins" queue moving to the next profile, E48.6).
  keepLease        Boolean   @default(false) @map("keep_lease")
  /// The profile's `checked_at` (node clock) when the browser was closed: a newer one is the offline check after the close.
  closeCheckedAt   String?   @map("close_checked_at") @db.VarChar(40)
  closeSentAt      DateTime? @map("close_sent_at") @db.Timestamptz
  /// The profile's sign-in state when the session ended (signed_in, signed_out, expired, unknown); never an email.
  resultState      String?   @map("result_state") @db.VarChar(12)
  /// Why an abandoned session ended: cancelled | timeout | profile_gone.
  endReason        String?   @map("end_reason") @db.VarChar(20)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt          DateTime? @map("ended_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([userId, hostId, status])
  @@map("profile_signin_sessions")
}

extend model User {
  profileSigninSessions ProfileSigninSession[]
}
