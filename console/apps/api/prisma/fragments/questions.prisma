// Questions (#288): what an agent (or a person's own automation) asks a
// person, and the answer. One broker for every channel: a browser-bound
// question mirrors a fabric handoff (`handoffId`), a free-standing one lives
// only here. `response` holds the answer as the API returns it and NEVER a
// secret value (a secret goes to the fabric, single use; the row records
// `valueWithheld: true`). Registered in the user-owned data registry
// (src/questions/questions.ownership.ts).

enum QuestionInput {
  none
  text
  secret
  choice
  multi_choice
  number
  confirm
  takeover
  /// A sign-in (#527): the username is kept, the password goes to the fabric only.
  credentials
  /// Several typed fields at once (#552): the missing parameters of a task run, asked before it starts.
  form
  /// A memory the agent proposes (#553): answered only in the signed-in web and app; the answer writes the memory.
  memory
  /// "Save this login?" (E37.4b): the sign-in the owner typed by hand, offered to their secrets provider; answered only in the signed-in web and app.
  save_login
  /// Scan or read something on the node's screen (#924): a sign-in QR, a number, Chrome's passkey QR. Browser-bound; answered with Done
  /// only in the signed-in web and app, which show a live picture the server captures on request and never stores.
  scan

  @@map("question_input")
}

enum QuestionStatus {
  pending
  answered
  cancelled
  expired

  @@map("question_status")
}

model Question {
  id               String         @id @default(uuid()) @db.Uuid
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  /// Who asked: `run:<id>`, `agent:<token name>` or `user:<id>`.
  askedBy          String         @map("asked_by") @db.VarChar(200)
  runId            String?        @map("run_id") @db.Uuid
  /// The fabric browser session a browser-bound question belongs to.
  fabricSessionId  String?        @map("fabric_session_id") @db.Uuid
  /// The mirrored fabric handoff (browser-bound questions only).
  handoffId        String?        @unique @map("handoff_id") @db.Uuid
  input            QuestionInput  @default(none)
  /// Why it is asked: captcha | code | passkey | login | confirmation | other.
  kind             String         @default("other") @db.VarChar(20)
  prompt           String         @db.VarChar(2000)
  /// Normalised options (`[{ id, label, description? }]`) of choice and multi_choice.
  options          Json?
  /// Input constraints (camelCase, see src/questions/questions.contract.ts).
  constraints      Json?
  /// `form` (#552): the fields `[{ key, label, type, required, options?, help?, constraints? }]`, at most 20.
  fields           Json?
  confirmLabel     String?        @map("confirm_label") @db.VarChar(40)
  denyLabel        String?        @map("deny_label") @db.VarChar(40)
  /// low | high, for confirm.
  risk             String?        @db.VarChar(8)
  /// credentials and secret: the site's "remember me" option in the page's words (#527).
  rememberLabel    String?        @map("remember_label") @db.VarChar(80)
  /// The commitment the server's confirmation gate stopped (#550): `{ host, category, label }`. Set by the
  /// server only, from the clicked element and the page the fabric reports; never from model text.
  gate             Json?
  /// What a "Don't ask again" tick would remember (#555): `{ kind, host, category, matchKey, summary }`.
  /// Computed by the server only (the gate's verdict or a fixed topic, and the page the fabric reports); never from model text.
  rememberable     Json?
  /// A call through one of the owner's connections the owner is asked to approve (E39.7): `{ connectionId, connectionLabel, tool, lines, body? }`,
  /// built by the server from the tool's validated arguments, never from model text. The run waits on this question with no browser handoff.
  action           Json?
  /// scan (#924): `{ source, domain, origin }`, set by the server when the question opens, from the page's address as the browser
  /// reports it; never from model or page text. No picture is stored.
  scan             Json?
  /// Why the harness itself asked (#909): `stall` for a stall handoff (`onStall: 'ask_human'`); null for every other question.
  /// Set by the runner only, never from a request or model text. A benchmark tells a stall from a real question by it.
  source           String?        @db.VarChar(20)
  /// The page the agent was on (browser-bound), for display.
  pageTitle        String?        @map("page_title") @db.VarChar(500)
  /// The fabric's viewer of the host's browser, when it has one.
  viewerUrl        String?        @map("viewer_url") @db.VarChar(2000)
  status           QuestionStatus @default(pending)
  /// `{ outcome, value?, values?, valueWithheld, channel?, by?, answeredAt }`: never a secret.
  response         Json?
  answeredByUserId String?        @map("answered_by_user_id") @db.Uuid
  answeredChannel  String?        @map("answered_channel") @db.VarChar(40)
  answeredAt       DateTime?      @map("answered_at") @db.Timestamptz
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz
  /// The AI app that asked (#464): its OAuth client, its display name at the time, its grant.
  /// Set by the server from the request's credential; `client_id` null with a name: an unverified MCP client name.
  clientId         String?        @map("client_id") @db.Uuid
  clientName       String?        @map("client_name") @db.VarChar(64)
  grantId          String?        @map("grant_id") @db.Uuid
  /// False for a question no run waits on (a memory proposal, #553): it never pauses a run, a run's end leaves it pending.
  blocking         Boolean        @default(true)
  /// memory: the proposed memory `{ kind, label, aliases, attributes, supersedes? }`; the owner edits it on the card.
  proposal         Json?
  /// memory: a hash of the proposal's kind and label, so a recently declined proposal is not made again.
  proposalKey      String?        @map("proposal_key") @db.VarChar(64)
  /// The chat a memory proposal came from (#553). A plain id: deleting the chat does not delete the question.
  conversationId   String?        @map("conversation_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  owner User @relation("QuestionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  run   Run? @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The run steps that asked or answered it (#541).
  steps RunStep[]

  @@index([ownerUserId, status, createdAt])
  @@index([status, expiresAt])
  @@index([runId])
  @@index([ownerUserId, proposalKey])
  @@map("questions")
}

extend model User {
  questions Question[] @relation("QuestionOwner")
}

extend model Run {
  questions Question[]
}
