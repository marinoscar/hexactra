// What the agent did with the owner's saved secrets (E37.4, #593): one sanitized,
// durable row per `secrets.lookup` and `secrets.release` audit event of the
// fabric. The fabric keeps those events only in an in-memory log of 2,000; a
// queue job (`secrets.activity.ingest`) copies them here so the Activity list on
// the Secrets page survives a restart.
//
// VALUE-FREE BY CONSTRUCTION. A row holds ids, the site's host, which field
// kind was typed (`username`, `password`, `one_time_code`), the purpose and the
// outcome code: never a username, a password, a code, a seed, a URL path or
// query, or any text the provider or a page supplied. `src/secrets/secrets-activity.ts`
// copies a whitelist of fields out of an event and drops the rest; a seeded-marker
// test proves it. NOT telemetry and not the provider's own audit.
// Registered in the user-owned data registry (src/secrets/secrets.ownership.ts).

// @extensible
model SecretsActivity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// When the fabric recorded the event.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  /// When this row was written.
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// `lookup` (asked the provider for the logins of a page) or `release` (a field was handed over to be typed).
  event      String   @db.VarChar(16)
  /// The fabric's operation id: with `event`, what makes the ingest idempotent.
  opId       String   @map("op_id") @db.Uuid
  /// The run (or chat browser) the fabric session belongs to, when it is one of ours and still exists.
  runId      String?  @map("run_id") @db.Uuid
  provider   String   @db.VarChar(20)
  /// The provider's own item id (opaque, not secret). Null for a lookup.
  itemId     String?  @map("item_id") @db.VarChar(100)
  /// `username`, `password`, `one_time_code`, an identity field or a card field. Null for a lookup.
  field      String?  @db.VarChar(20)
  /// The host (with a non-default port) of the page: never the path, query or user info.
  site       String?  @db.VarChar(255)
  purpose    String?  @db.VarChar(20)
  /// A closed code of the fabric: `typed`, `ok`, `not_found`, `origin_mismatch`, `disabled`, ... Anything unknown is stored as `other`.
  outcome    String   @db.VarChar(32)
  /// How many logins a lookup found.
  matches    Int?
  /// The provider handed a value over (it may still not have been typed). Never the value.
  released   Boolean  @default(false)
  /// A card field (E37.7): the purchase's amount and currency and the payment frame's host. Null for everything else.
  amount     String?  @db.VarChar(16)
  currency   String?  @db.VarChar(3)
  frameSite  String?  @map("frame_site") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opId, event])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("secrets_activity")
}

extend model User {
  secretsActivity SecretsActivity[]
}
