// Secrets providers (E37.2, #591): one row per owner and provider, the
// connection to the owner's Vault. It holds NO secret: the OAuth refresh token,
// the access token, the PKCE verifier and the client secret live in the
// encrypted per-user credential store (purposes `secrets_vault_grant` and
// `secrets_vault_client`, src/secrets/secrets.credentials.ts). What is stored
// here is what the owner may read: the address, the client id, the scopes the
// owner consented to, when it was connected and last used, and the status.
// Registered in the user-owned data registry (src/secrets/secrets.ownership.ts).

/// `disconnected`: configured (or just disconnected), no grant. `connected`: a grant whose refresh token works.
/// `needs_reconnect`: Vault refused the refresh token (revoked, replayed or expired): the owner connects again.
enum SecretsConnectionStatus {
  disconnected
  connected
  needs_reconnect

  @@map("secrets_connection_status")
}

// @extensible
model SecretsConnection {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  /// `vault` today. A plain string so a later provider needs no migration.
  provider          String                  @db.VarChar(20)
  status            SecretsConnectionStatus @default(disconnected)
  /// The Vault's address (`https://vault.example.test`), validated against private-address rules when saved and again on every call. Null: the deployment default applies.
  baseUrl           String?                 @map("base_url") @db.VarChar(2048)
  /// The OAuth client id registered at the Vault. Null: the deployment default applies.
  clientId          String?                 @map("client_id") @db.VarChar(200)
  /// The scopes the owner consented to (`vault:items_read`, ...), as the Vault granted them.
  scopes            String[]                @default([])
  /// The owner's user id at the Vault (from `whoami`).
  providerUserId    String?                 @map("provider_user_id") @db.VarChar(100)
  /// Whether the Vault's own agent access is switched on: `on`, `off` (it answered 403 AGENT_ACCESS_DISABLED) or `unknown`.
  agentAccess       String                  @default("unknown") @map("agent_access") @db.VarChar(10)
  /// When the stored access token stops working. The token itself is in the credential store.
  accessExpiresAt   DateTime?               @map("access_expires_at") @db.Timestamptz
  /// The refresh lease: one refresh at a time per connection (a replayed refresh token revokes the whole grant).
  refreshLeaseUntil DateTime?               @map("refresh_lease_until") @db.Timestamptz
  connectedAt       DateTime?               @map("connected_at") @db.Timestamptz
  lastUsedAt        DateTime?               @map("last_used_at") @db.Timestamptz
  lastSuccessAt     DateTime?               @map("last_success_at") @db.Timestamptz
  /// A stable code (`ORIGIN_MISMATCH`, `UNAUTHORIZED`, ...), never a message that could carry data.
  lastErrorCode     String?                 @map("last_error_code") @db.VarChar(60)
  lastErrorAt       DateTime?               @map("last_error_at") @db.Timestamptz
  /// When the owner was told this connection needs reconnecting (once per episode; cleared on reconnect).
  reconnectNotifiedAt DateTime?             @map("reconnect_notified_at") @db.Timestamptz
  /// The pending authorization of a Connect in progress: the SHA-256 of `state`, of the browser-binding cookie and its expiry. The PKCE verifier is in the credential store.
  pendingStateHash  String?                 @unique @map("pending_state_hash") @db.VarChar(64)
  pendingBindingHash String?                @map("pending_binding_hash") @db.VarChar(64)
  pendingExpiresAt  DateTime?               @map("pending_expires_at") @db.Timestamptz
  pendingScopes     String[]                @default([]) @map("pending_scopes")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([status])
  @@map("secrets_connections")
}

extend model User {
  secretsConnections SecretsConnection[]
}
