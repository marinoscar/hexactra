// The built-in secrets store (E37.5, #594): one wrapped data key per owner.
//
// The store's secrets are the Vault domain tables (`secrets`, `secret_versions`, ... from
// `@marinoscar/vault-db`, composed into this schema as `app.vault.*`). Their values are
// AES-256-GCM ciphertext under the OWNER's data key; the data key is random, per owner, and
// is itself stored only WRAPPED (AES-256-GCM under the deployment's `SECRETS_STORE_KEY`,
// which lives in the environment, never in this database). So a database dump holds
// ciphertext and wrapped keys only: it cannot be decrypted without the deployment key.
// `key_id` names the store key that wrapped it (the first 8 hex characters of the key's
// SHA-256, not secret), so rotation knows which rows still need re-wrapping.
// Registered in the user-owned data registry (src/secrets/builtin/store.ownership.ts).

model SecretsStoreDataKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  /// The id of the store key that wraps `wrapped` (a SHA-256 prefix; identifies, reveals nothing).
  keyId       String    @map("key_id") @db.VarChar(16)
  /// `base64(iv || authTag || ciphertext)` of the 32-byte data key under the store key. Never the key.
  wrapped     String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// When the key was last re-wrapped under a newer store key.
  rewrappedAt DateTime? @map("rewrapped_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyId])
  @@map("secrets_store_data_keys")
}

extend model User {
  secretsStoreDataKey SecretsStoreDataKey?
}
