// Tasks, runs and run steps (#224): what browser agents are asked to do and
// what they did. A Task is a reusable goal; a Run is one attempt at it (or an
// external agent's session, with no task); RunSteps are the actions taken.
// Steps store REDACTED arguments only: typed text and secret values never
// reach this table (src/tasks/redact.ts). Registered in the user-owned data
// registry (src/tasks/tasks.ownership.ts).

enum RunStatus {
  queued
  running
  waiting_human
  succeeded
  failed
  cancelled

  @@map("run_status")
}

enum RunTrigger {
  manual
  schedule
  api
  mcp
  external

  @@map("run_trigger")
}

/// Why a run stopped (#404). `budget_*` is a budget of the run's policy (or a deployment
/// ceiling); `stalled` is stall detection; `no_model` is no usable model.
enum RunStopReason {
  finished
  budget_actions
  budget_model_calls
  budget_active_time
  budget_input_tokens
  budget_output_tokens
  budget_cost
  stalled
  cancelled
  error
  no_model

  @@map("run_stop_reason")
}

// @extensible
model Task {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(200)
  goal           String   @db.VarChar(4000)
  /// Fabric browser profile the runs use.
  profile        String   @default("default") @db.VarChar(32)
  /// Pin runs to one fabric host; null lets the fabric choose.
  hostId         String?  @map("host_id") @db.Uuid
  /// When the chosen host cannot take a run, run on another available one (#384).
  hostFallback   Boolean  @default(true) @map("host_fallback")
  /// Hostnames the agent may navigate to (suffix match); empty allows any.
  allowedDomains String[] @default([]) @map("allowed_domains")
  /// Defaults mirror TASK_DEFAULTS (tasks/task-defaults.ts); a test keeps them equal (#399).
  maxSteps       Int      @default(100) @map("max_steps")
  maxMinutes     Int      @default(30) @map("max_minutes")
  /// Pause for a person before steps that look like a purchase or submission.
  confirmRiskyActions Boolean @default(true) @map("confirm_risky_actions")
  /// AI model id; null uses the user's default.
  model          String?  @db.VarChar(200)
  /// An own policy's UUID or `builtin:<key>`; null follows the user's default (#401).
  /// Text, not a foreign key: built-ins are not rows (validated in the service).
  /// `max_steps`, `max_minutes` and `model` above are deprecated: readable for one release.
  policyRef      String?  @map("policy_ref") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs Run[]

  @@index([userId, createdAt])
  @@map("tasks")
}

// @extensible
model Run {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  taskId          String?    @map("task_id") @db.Uuid
  status          RunStatus  @default(queued)
  trigger         RunTrigger @default(manual)
  /// The goal as it was when the run started (a task may change later).
  goal            String     @db.VarChar(4000)
  profile         String     @default("default") @db.VarChar(32)
  hostId          String?    @map("host_id") @db.Uuid
  /// Copied from the task (or the request) at start (#384).
  hostFallback    Boolean    @default(true) @map("host_fallback")
  /// Fabric session the run drives.
  sessionId       String?    @map("session_id") @db.Uuid
  /// Open fabric handoff while `waiting_human`.
  handoffId       String?    @map("handoff_id") @db.Uuid
  /// Who or what started it (an agent framework's name for external runs).
  actor           String?    @db.VarChar(200)
  result          String?    @db.VarChar(8000)
  error           String?    @db.VarChar(2000)
  cancelRequested Boolean    @default(false) @map("cancel_requested")
  stepCount       Int        @default(0) @map("step_count")
  /// What the goal runner is doing right now (#379): `{ phase, action?, args?, reason?, startedAt, timeoutMs? }`.
  /// Redacted like step args; cleared whenever the run leaves `running`.
  activity        Json?
  inputTokens     Int        @default(0) @map("input_tokens")
  outputTokens    Int        @default(0) @map("output_tokens")
  /// Input tokens the provider served from its cache (a subset of `input_tokens`).
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  /// Provider round trips the goal runner made (E31.2).
  modelCalls      Int        @default(0) @map("model_calls")
  /// USD spent on model calls, from the admin's price table; a lower bound while `cost_known` is false.
  costUsd         Decimal    @default(0) @map("cost_usd") @db.Decimal(12, 6)
  /// False once a call could not be priced (its model is not in the price table).
  costKnown       Boolean    @default(true) @map("cost_known")
  /// Milliseconds the run has spent in `running`, settled each time it leaves
  /// that status. Waiting for a person never counts (#399).
  activeMs        Int        @default(0) @map("active_ms")
  /// When the run last entered `running`; null while it is not running.
  activeSince     DateTime?  @map("active_since") @db.Timestamptz
  /// The AI conversation so far, so a run can resume after a handoff.
  /// Never holds secret values (they are typed by the runner, not the model).
  transcript      Json?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  startedAt       DateTime?  @map("started_at") @db.Timestamptz
  finishedAt      DateTime?  @map("finished_at") @db.Timestamptz
  /// Reminders while `waiting_human` (tasks/run-reminders.ts); cleared when the run stops waiting.
  /// When the run started waiting for its person.
  waitingSince     DateTime? @map("waiting_since") @db.Timestamptz
  /// When the open handoff expires on the fabric (null: unknown).
  handoffExpiresAt DateTime? @map("handoff_expires_at") @db.Timestamptz
  /// When the reminder job next looks at this run (null: nothing due).
  remindAt         DateTime? @map("remind_at") @db.Timestamptz
  /// When the last reminder was sent.
  remindedAt       DateTime? @map("reminded_at") @db.Timestamptz
  reminderCount    Int       @default(0) @map("reminder_count")
  /// "Remind me in 15 min" from a notification.
  snoozedUntil     DateTime? @map("snoozed_until") @db.Timestamptz

  /// Agent policy (#401). Before the first advance: the run or schedule override, when
  /// there is one. From the first advance: the policy the run runs under.
  policyRef        String?       @map("policy_ref") @db.VarChar(64)
  policyVersion    Int?          @map("policy_version")
  /// RunPolicySnapshot (src/policies/policy-snapshot.ts), written once at the first advance.
  policySnapshot   Json?         @map("policy_snapshot")
  /// Why that policy applied.
  policySource     PolicySource? @map("policy_source")
  /// Why the run stopped (#404); null while it is running, and on runs from before this column.
  stopReason       RunStopReason? @map("stop_reason")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  steps RunStep[]

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@index([status])
  @@index([remindAt])
  @@map("runs")
}

model RunStep {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  seq           Int
  /// action | handoff | finish | error | note
  kind          String   @db.VarChar(20)
  /// The fabric action type (navigate, click, …) for kind=action.
  action        String?  @db.VarChar(40)
  /// Redacted arguments: never typed text or secret values.
  args          Json?
  ok            Boolean  @default(true)
  summary       String   @default("") @db.VarChar(2000)
  /// What the model said it was doing (its own words, trimmed).
  reasoning     String?  @db.VarChar(2000)
  /// Object-storage key of the screenshot taken at this step.
  screenshotKey String?  @map("screenshot_key") @db.VarChar(500)
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("run_steps")
}

extend model User {
  tasks Task[]
  runs  Run[]
}
