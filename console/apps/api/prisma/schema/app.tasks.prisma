  stoppedAtSeq   Int?       @map("stopped_at_seq")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime?  @map("started_at") @db.Timestamptz
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  items        RunBatchItem[]
  runs         Run[]

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status])
  @@map("run_batches")
}

/// One row of a batch: the checked values (never a sensitive one) and how its run ended.
model RunBatchItem {
  id      String  @id @default(uuid()) @db.Uuid
  batchId String  @map("batch_id") @db.Uuid
  /// 1..n, unique per batch.
  seq     Int
  /// The checked values, by parameter key (strings). Never a `sensitive` parameter: a task with one cannot be batched.
  inputs  Json
  /// pending | running | succeeded | failed | cancelled | skipped
  status  String  @default("pending") @db.VarChar(12)
  runId   String? @unique @map("run_id") @db.Uuid
  /// When the row was claimed to start (reconcile: a claimed row whose run was never created goes back to pending).
  startedAt DateTime? @map("started_at") @db.Timestamptz

  batch RunBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// The row's run: deleting the run (retention, the owner) clears it; the row keeps its status.
  run   Run?     @relation("RunBatchItemRun", fields: [runId], references: [id], onDelete: SetNull)

  @@unique([batchId, seq])
  @@map("run_batch_items")
}
