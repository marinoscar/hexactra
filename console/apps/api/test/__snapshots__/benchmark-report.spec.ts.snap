        "body": [
          [
            {
              "style": "factKey",
              "text": "Suite",
            },
            {
              "style": "factValue",
              "text": "core version 1: benchmarks compare only within one suite version.",
            },
          ],
          [
            {
              "style": "factKey",
              "text": "Trials",
            },
            {
              "style": "factValue",
              "text": "3 per challenge and policy, one at a time, the policies alternating, on a node the fabric picks (browser profile default).",
            },
          ],
          [
            {
              "style": "factKey",
              "text": "Spend cap",
            },
            {
              "style": "factValue",
              "text": "$5.00: no new trial starts once it is spent. Trial timeout 15 min.",
            },
          ],
          [
            {
              "style": "factKey",
              "text": "Recordings",
            },
            {
              "style": "factValue",
              "text": "Off.",
