        },
        {
          "description": "Ask the person for what only they have: a username, a password, a one-time code, a passkey touch, a CAPTCHA, a choice, a number, or a confirmation before an irreversible step (kind "verification": their bank wants them to confirm a payment in a banking app). For a sign-in, ask once for the username and password (kind login, input credentials), then any code (kind code, input secret), and type each yourself; do not ask the person to sign in in the browser. input: none (they do something, then press Done), text, secret (a code or password; type it with type_handoff_secret), credentials (a username, typed with type_text, and a password, typed with type_handoff_secret), choice (one of options), multi_choice (several of options), number (with constraints min/max/step/unit), confirm (approve or deny; risk "high" by default), scan (they scan or read what is on the screen with their phone, then press Done: a sign-in QR code the page shows, a number to match in an app, or Chrome's "use a phone or tablet" passkey QR code; kind passkey, login, verification or code; scan_source "page" for a code the page draws, "desktop" for Chrome's own passkey window; they see a live picture the server takes, never one you send), takeover (they take over the browser, then press Done: only for a passkey on this computer or a security key, a CAPTCHA you cannot pass, or when they declined to give a credential). Set the fields that do not apply to null. The run pauses until they answer.",
          "name": "request_human",
          "parameters": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "choices": {
                "anyOf": [
                  {
                    "items": {
                      "maxLength": 100,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "type": "array",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "confirm_label": {
                "anyOf": [
                  {
                    "maxLength": 40,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "constraints": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "max": {
                        "type": [
                          "number",
                          "null",
                        ],
                      },
                      "max_length": {
                        "anyOf": [
                          {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "max_selections": {
                        "anyOf": [
                          {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "min": {
                        "type": [
                          "number",
                          "null",
                        ],
                      },
                      "min_selections": {
                        "anyOf": [
                          {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "multiline": {
                        "type": [
                          "boolean",
                          "null",
                        ],
                      },
                      "pattern": {
                        "anyOf": [
                          {
                            "maxLength": 200,
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "step": {
                        "type": [
                          "number",
                          "null",
                        ],
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "maxLength": 20,
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                    },
                    "required": [
                      "max_length",
                      "pattern",
                      "multiline",
                      "min",
                      "max",
                      "step",
                      "unit",
                      "min_selections",
                      "max_selections",
                    ],
                    "type": "object",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "deny_label": {
                "anyOf": [
                  {
                    "maxLength": 40,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "input": {
                "enum": [
                  "none",
                  "text",
                  "secret",
                  "choice",
                  "multi_choice",
                  "number",
                  "confirm",
                  "takeover",
                  "credentials",
                  "scan",
                ],
                "type": "string",
              },
              "kind": {
                "enum": [
                  "captcha",
                  "code",
                  "passkey",
                  "login",
                  "confirmation",
                  "verification",
                  "other",
                ],
                "type": "string",
              },
              "options": {
                "anyOf": [
                  {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "description": {
                          "anyOf": [
                            {
                              "maxLength": 200,
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "id": {
                          "maxLength": 64,
                          "type": "string",
                        },
                        "label": {
                          "maxLength": 100,
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "label",
                        "description",
                      ],
                      "type": "object",
                    },
                    "maxItems": 10,
                    "type": "array",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "prompt": {
                "maxLength": 1500,
                "minLength": 1,
                "type": "string",
              },
              "remember_label": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "risk": {
                "anyOf": [
                  {
                    "enum": [
                      "low",
                      "high",
                    ],
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "scan_source": {
                "anyOf": [
                  {
                    "enum": [
                      "page",
                      "desktop",
                    ],
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "topic": {
                "anyOf": [
                  {
                    "maxLength": 40,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
            },
            "required": [
              "kind",
              "prompt",
              "input",
              "choices",
              "options",
              "constraints",
              "confirm_label",
              "deny_label",
              "risk",
              "remember_label",
              "topic",
              "scan_source",
            ],
            "type": "object",
          },
          "strict": true,
        },
        {
          "description": "Type the secret (code or password) the person gave through request_human into an input. You never see the value. For a code split across several one-character boxes, pass the first box: every box is filled and the result says how many. For a sensitive task value shown in the goal as [provided: <name>], pass that name as parameter; otherwise null.",
          "name": "type_handoff_secret",
          "parameters": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "anyOf": [
                  {
                    "maxLength": 80,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "selector": {
                "maxLength": 2000,
                "type": "string",
              },
              "submit": {
                "type": "boolean",
              },
            },
            "required": [
              "selector",
              "submit",
              "parameter",
            ],
            "type": "object",
          },
          "strict": true,
        },
        {
          "description": "Search the public web. Returns titles, addresses and short excerpts. Use it to find out a fact or to find the right page, then web_fetch to read a page in full.",
          "name": "web_search",
          "parameters": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "count": {
                "anyOf": [
                  {
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "freshness": {
                "anyOf": [
                  {
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "year",
                    ],
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "query": {
                "maxLength": 400,
                "minLength": 2,
                "type": "string",
              },
              "site": {
                "anyOf": [
                  {
                    "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
            },
            "required": [
              "query",
              "count",
              "freshness",
              "site",
            ],
