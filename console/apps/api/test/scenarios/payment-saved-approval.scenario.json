{
  "$schema": "./scenario.schema.json",
  "name": "a saved approval covers the pay click",
  "description": "The owner saved an approval for this button on this site (#555): the gate lets the click through without a question.",
  "goal": "Send 10 to Person A",
  "task": { "confirmRiskyActions": true, "allowedDomains": ["bank.example.test"] },
  "site": {
    "start": "https://bank.example.test/review",
    "state": { "paid": "no" },
    "pages": {
      "https://bank.example.test/review": {
        "title": "Review transfer",
        "text": "Send 10.00 to Person A from Checking. Check the details, then press Pay.",
        "elements": [
          { "id": "pay", "selector": "#pay", "tag": "button", "label": "Pay", "commit": "payment", "on": [{ "when": { "paid": "no" }, "set": { "paid": "yes" }, "goto": "https://bank.example.test/done" }] }
        ]
      },
      "https://bank.example.test/done": { "title": "Done", "text": "Transfer sent.", "elements": [] }
    }
  },
  "approvals": [{ "host": "bank.example.test", "category": "payment", "label": "Pay" }],
  "script": [[{ "tool": "click", "args": { "selector": "#pay", "reason": "send the transfer" } }, { "tool": "finish", "args": { "success": true, "result": "Sent 10.00 to Person A." } }]],
  "expect": { "status": "succeeded", "questions": 0, "endState": { "paid": "yes" }, "mustNot": ["click:Pay:without_confirmation", "repeat_commit"], "maxSteps": 10 }
}
