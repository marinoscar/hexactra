{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hexactra replay scenario",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "default": "builtin:balanced",
      "type": "string",
      "pattern": "^builtin:(economy|balanced|thorough|unlimited)$"
    },
    "trigger": {
      "default": "manual",
      "description": "`chat` makes the budgets soft (#537); anything else keeps them hard",
      "type": "string",
      "enum": [
        "manual",
        "chat",
        "schedule"
      ]
    },
    "task": {
      "default": {
        "confirmRiskyActions": false,
        "allowedDomains": []
      },
      "type": "object",
      "properties": {
        "confirmRiskyActions": {
          "default": false,
          "type": "boolean"
        },
        "allowedDomains": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "vision": {
      "default": false,
      "description": "Synthetic screenshots with numbered marks; off by default",
      "type": "boolean"
    },
    "site": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "The URL the browser is on when the run starts"
        },
        "state": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "pages": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The visible text. {{state.key}} is replaced by the site state; an injection scenario puts hostile text here"
              },
              "elements": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The id of the element in the site state; what typing into an input sets"
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tag": {
                      "default": "button",
                      "type": "string"
                    },
                    "role": {
                      "description": "The explicit role attribute, as the page reports it (null for a plain button or input)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "description": "What a person reads on it"
                    },
                    "type": {
                      "description": "The input type (text, password, date, submit)",
                      "type": "string"
                    },
                    "formAction": {
                      "description": "Where the form this element submits posts to (the risk gate reads it)",
                      "type": "string"
                    },
                    "commit": {
                      "description": "The SITE's own class for an action it cannot undo (payment, send, delete): the invariants watch it, the harness does not read it",
                      "type": "string"
                    },
                    "secret": {
                      "description": "An input whose value a read of the page shows only as dots",
                      "type": "boolean"
                    },
                    "on": {
                      "description": "What a click does",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "when": {
                            "description": "The site state this effect needs ({\"paid\": \"no\"}); the first effect whose condition holds is applied",
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "set": {
                            "description": "State to set. A value may use {{state.key}}",
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "goto": {
                            "description": "The page to go to (a URL of this site, or another site)",
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "selector",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false
          },
          "description": "Pages by URL without the query"
        }
      },
      "required": [
        "start",
        "pages"
      ],
      "additionalProperties": false
    },
    "owner": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "promptIncludes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "answer": {
            "type": "string",
            "enum": [
              "approve",
              "deny",
              "text",
              "secret",
              "credentials",
              "choice",
              "done",
              "decline"
            ]
          },
          "value": {
            "description": "text, choice, a typed secret, or the username of credentials",
            "type": "string"
          },
          "password": {
            "description": "credentials: the password the fabric types (never shown to the agent)",
            "type": "string"
          },
          "repeat": {
            "description": "The rule answers every matching question, not only the first",
            "type": "boolean"
          }
        },
        "required": [
          "when",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "approvals": {
      "default": [],
      "description": "The owner's saved approvals",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "category",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "default": [],
      "description": "Strings that must never appear in a step, the memory, a model input or a span (marker strings, typed values)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected": {
      "default": {},
      "description": "Site state the page's text must not change: key to the value the owner gave",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "script": {
      "default": [],
      "description": "Scripted mode: the model's tool calls, one list per model call. Ignored in live mode.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "description": "The name of a tool the model is offered (observe_elements, navigate, click, type_text, request_human, finish, ...)"
            },
            "args": {
              "description": "Its arguments. `reason`, `submit` and the other nullable fields may be left out: the kit fills them.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "tool"
          ],
          "additionalProperties": false
        },
        "description": "One model call: the tool calls it makes, in order"
      }
    },
    "harness": {
      "default": {},
      "type": "object",
      "properties": {
        "sabotage": {
          "description": "Break a part of the harness on purpose, to prove an invariant notices. Only the violation scenarios use it.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gates_off",
              "stop_ignored",
              "pause_ignored"
            ]
          }
        },
        "crash": {
          "description": "The job dies around the click: before it is sent (nothing happened) or after (it happened, the result was lost). The run continues in a new job.",
          "type": "object",
          "properties": {
            "when": {
              "type": "string",
              "enum": [
                "before_send",
                "after_send"
              ]
            },
            "label": {
              "type": "string",
              "description": "The element whose click the job dies around"
            }
          },
          "required": [
            "when",
            "label"
          ],
          "additionalProperties": false
        },
        "scriptAfterCrash": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The name of a tool the model is offered (observe_elements, navigate, click, type_text, request_human, finish, ...)"
                },
                "args": {
                  "description": "Its arguments. `reason`, `submit` and the other nullable fields may be left out: the kit fills them.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "tool"
              ],
              "additionalProperties": false
            },
            "description": "One model call: the tool calls it makes, in order"
          }
        },
        "stopAfterActions": {
          "description": "The owner presses Stop after this many actions reached the browser (in the middle of a chunk)",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pauseAfterActions": {
          "description": "The owner presses Pause after this many actions",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resumeAfterPause": {
          "type": "boolean"
        },
        "scriptAfterPause": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The name of a tool the model is offered (observe_elements, navigate, click, type_text, request_human, finish, ...)"
                },
                "args": {
                  "description": "Its arguments. `reason`, `submit` and the other nullable fields may be left out: the kit fills them.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "tool"
              ],
              "additionalProperties": false
            },
            "description": "One model call: the tool calls it makes, in order"
          }
        },
        "budget": {
          "description": "Limits for this run, over the policy's",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "maxActions",
              "maxModelCalls",
              "maxActiveMinutes",
              "maxInputTokens",
              "maxOutputTokens",
              "maxCostUsd",
              "maxWebCalls"
            ]
          },
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stall": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "maxConsecutiveFailures",
              "maxRepeatedAction",
              "noProgressActions",
              "maxEscalations"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "additionalProperties": false
    },
    "connections": {
      "default": [],
      "description": "The owner's accounts and MCP servers this run lists (E41.1)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^c\\d+$",
            "description": "The reference connections_list gives it: c1, c2, ... in the order of this list"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "microsoft",
              "mcp"
            ]
          },
          "access": {
            "default": "read_write",
            "description": "Deprecated (E50.17): ignored. The access follows the switches: read and change when a change capability (an MCP write tool) is on.",
            "type": "string",
            "enum": [
              "read",
              "read_write"
            ]
          },
          "email": {
            "type": "string"
          },
          "capabilities": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mail_read",
                "mail_send",
                "mail_modify",
                "calendar_read",
                "calendar_write",
                "docs_read",
                "docs_write"
              ]
            }
          },
          "defaultFor": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mail": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "default": [
                    "owner@example.test"
                  ],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "subject": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "description": "ISO instant with offset"
                },
                "body": {
                  "type": "string"
                },
                "attachments": {
                  "default": [],
                  "description": "File names; the content is invented",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "from",
                "subject",
                "date",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "events": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "files": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "document",
                    "spreadsheet",
                    "pdf",
                    "other"
                  ]
                },
                "text": {
                  "description": "A document's text",
                  "type": "string"
                },
                "sheet": {
                  "description": "A spreadsheet's tab (default Sheet1)",
                  "type": "string"
                },
                "rows": {
                  "description": "A spreadsheet's rows",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                "modifiedAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "instructions": {
            "description": "mcp: what the server says it is for",
            "type": "string"
          },
          "tools": {
            "default": [],
            "description": "mcp: its tools",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "inputSchema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "The tool's JSON schema"
                },
                "effect": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write"
                  ]
                },
                "result": {
                  "type": "string",
                  "description": "The text the server answers"
                }
              },
              "required": [
                "name",
                "description",
                "inputSchema",
                "effect",
                "result"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref",
          "label",
          "provider"
        ],
        "additionalProperties": false
      }
    },
    "web": {
      "description": "Web search (E50.7): set up for this owner, with these results and pages. Absent: not set up, the tools are not offered",
      "type": "object",
      "properties": {
        "on": {
          "default": true,
          "description": "The owner's web search switch (a provider is set up): off, web_search and web_fetch are not offered",
          "type": "boolean"
        },
        "fetch": {
          "default": true,
          "description": "The administrator's web_fetch switch",
          "type": "boolean"
        },
        "results": {
          "default": {},
          "description": "What a query answers (exact query); any other query has no results",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "An https address of an invented host"
                },
                "snippet": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "pages": {
          "default": {},
          "description": "What web_fetch reads, by address; an injection scenario puts hostile text here",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "blocked": {
          "default": [],
          "description": "Addresses a server cannot read (sign-in, a bot check): web_fetch says to open them in the browser",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "needsBrowser": {
      "default": "auto",
      "description": "A task that never opens a browser is offered no browser tool",
      "type": "string",
      "enum": [
        "auto",
        "never",
        "always"
      ]
    },
    "context": {
      "description": "\"Earlier in this conversation\": what a chat's earlier jobs found, as the run reads it",
      "type": "string"
    },
    "previousJob": {
      "description": "The chat's previous job (E41.4): the masked pictures it stored, which run \"previous\" attachments reach",
      "type": "object",
      "properties": {
        "screenshots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "moment": {
                "type": "string",
                "enum": [
                  "question",
                  "before_confirmed",
                  "after_confirmed",
                  "failure",
                  "final",
                  "saved"
                ]
              }
            },
            "required": [
              "step",
              "moment"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "waiting_human",
            "paused"
          ]
        },
        "mustAsk": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "promptIncludes": {
                "type": "string"
              },
              "beforeLabel": {
                "description": "The question is asked before the site activates the element with this label",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "mustNot": {
          "default": [],
          "description": "Rules this scenario guards by name (`click:Pay:without_confirmation`, `navigate:outside_allowed_sites`, `repeat_commit`): a match fails it. Every rule is checked either way.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violations": {
          "default": [],
          "description": "A scenario that breaks a rule on purpose lists the violations it must report (by rule name or `rule:detail`); it passes only when exactly these are reported.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxSteps": {
          "default": 40,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "endState": {
          "default": {},
          "description": "The site state at the end",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "finishIncludes": {
          "type": "string"
        },
        "stopReason": {
          "description": "The stop reason of a run that did not finish (budget_actions, stalled, ...)",
          "type": "string"
        },
        "tierAtEnd": {
          "type": "string",
          "enum": [
            "fast",
            "standard",
            "frontier"
          ]
        },
        "questions": {
          "description": "Exactly this many questions were asked of the owner",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "actionsReachedBrowser": {
          "description": "Exactly this many actions reached the browser",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "toolsUsed": {
          "description": "Each named tool was called at least once",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mustNotUseFamily": {
          "description": "No call of a tool of these families (browser, desktop, accounts, mcp, mcp:<ref>)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "firstToolFamily": {
          "description": "The family of the first tool call that is not control or human",
          "type": "string"
        },
        "sent": {
          "description": "What the fake mailboxes sent",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "description": "The connection's ref or label"
              },
              "to": {
                "type": "string",
                "description": "One recipient the message went to"
              },
              "subjectIncludes": {
                "type": "string"
              },
              "bodyIncludes": {
                "type": "string"
              },
              "attachments": {
                "description": "Exactly this many attachments",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
