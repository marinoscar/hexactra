# -----------------------------------------------------------------------------
# App variables
# -----------------------------------------------------------------------------
# Variables of this application only, appended to infra/compose/.env.example
# after the platform's by `platform-infra sync` (this file is APP-OWNED: it is
# created once and never overwritten; .env.example itself is generated). Add a
# variable here as KEY=value with its explanation on the lines above it, then
# run the sync. Never add a commented-out KEY=value line: the deploy wizard
# reads every such line as a declared variable.

# -----------------------------------------------------------------------------
# Hexactra Fabric (infra/compose/app.fabric.compose.yml)
# -----------------------------------------------------------------------------
# The fabric control plane's operator token: the bundled browser host uses it,
# and you use it once to mint the console's hxs_ service token (runbook:
# docs/runbooks/vps-stack.md). Generate with: openssl rand -hex 32
HEXACTRA_FABRIC_OPERATOR_TOKEN=
# The bundled browser host (a container on this server) is optional (#343):
# browsers belong on nodes at home, which keep a residential IP (docs/nodes.md).
# The value bundled-host runs it, and its desktop opens in the console like any
# node's; the value none leaves it off. The first deploy that knows this key
# keeps the bundled host where it already exists and leaves it off on a new
# server.
COMPOSE_PROFILES=
# Name the bundled browser host registers under.
HEXACTRA_FABRIC_HOST_NAME=local
# Browsers (profiles) the bundled host keeps open at once (300-600 MB each).
HEXACTRA_MAX_BROWSERS=1
# Where the fabric sends its OpenTelemetry traces and metrics (OTLP/HTTP).
# With the telemetry overlay (telemetry.compose.yml) use
# http://otel-collector:4318, so console and fabric traces join in one store.
# Empty: the fabric exports nothing.
HEXACTRA_FABRIC_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Rate limits of the MCP endpoint and the OAuth server (#517)
# -----------------------------------------------------------------------------
# Where the API counts its rate limits. memory (the default) counts in each API
# process: right for the one API container the stack runs. postgres counts in
# the database table rate_limit_windows, shared by every API process: set it
# when you run more than one API replica, or each replica allows the full limit
# and the limits multiply. Deployment topology, read at boot (restart the API
# after changing it); any other value stops the API from starting.
# docs/runbooks/public-exposure.md, section 4.
MCP_RATE_LIMIT_STORE=memory

# -----------------------------------------------------------------------------
# Caller addresses behind the proxy (#530)
# -----------------------------------------------------------------------------
# Which proxies the API trusts to forward the caller's address (X-Forwarded-For),
# for its per-address limits: the unauthenticated MCP limit and the OAuth
# server's authorize and register limits. Empty (the default) trusts loopback,
# link-local and private ranges, which covers the stack's own nginx and a tunnel
# or proxy on the same private network. The value false trusts no proxy: every
# caller then counts as nginx's address and shares one bucket. Otherwise a
# comma-separated list of IP addresses or CIDRs (for example the stack network's
# subnet). true and a hop count are refused, as is any malformed entry: the API
# then stops at boot. Read at boot (restart the API after changing it).
# docs/runbooks/public-exposure.md, section 4.
TRUST_PROXY=

# -----------------------------------------------------------------------------
# Built-in secrets store (E37.5, docs/secrets.md)
# -----------------------------------------------------------------------------
# The built-in store keeps the owners' saved logins in this database, encrypted,
# so someone without a separate Vault still gets them. It is switched on and off
# in Administration -> Secrets (off by default), never here. Its key is the one
# thing it needs from this file: 32 random bytes in base64, generated by the
# installer and never replaced once set. It wraps each owner's own data key; it
# is not SECRETS_ENCRYPTION_KEY and not derived from it. Back it up SEPARATELY
# from the database: a database backup holds ciphertext only, and losing the key
# loses every saved login for good. Never log it or paste it into a ticket. A
# malformed key stops the API at boot. To rotate it, put the old key in .env as
# SECRETS_STORE_KEY_PREVIOUS during the rotation (docs/secrets.md, "Rotating the
# store key"). Read at boot.
SECRETS_STORE_KEY=
# The address of THIS API as the fabric reaches it, for the fabric's call back
# to the store's internal release route. Empty: http://api:3000 (the compose
# network of the bundled stack). Across the Internet use an https address that
# the public proxy does not serve under /api/internal/ (docs/secrets.md).
SECRETS_STORE_CALLBACK_URL=
