{
  "name": "@marinoscar/hexactra-web-agent",
  "version": "0.1.0-next.0",
  "description": "The Hexactra web toolset for @marinoscar/hexactra-agent: web_search and web_fetch, the web family and its research guidance, the web site gate, and the WebSearchPort and WebFetchPort a host binds (CommonJS).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/hexactra.git",
    "directory": "console/packages/hexactra-web-agent"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./families": {
      "types": "./dist/families.d.ts",
      "default": "./dist/families.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "default": "./dist/gates/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./test/jest.config.js",
    "test:run": "jest --config ./test/jest.config.js --ci"
  },
  "dependencies": {
    "@marinoscar/hexactra-agent": "0.1.0-next.0"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
