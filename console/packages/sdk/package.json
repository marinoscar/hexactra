{
  "name": "@hexactra/console-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the Hexactra Console REST API, generated from its OpenAPI document.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "run-trace.schema.json"
  ],
  "scripts": {
    "generate": "npx --yes openapi-typescript@7.13.0 --default-non-nullable=false ./openapi.json -o ./src/schema.d.ts",
    "build": "tsc -p tsconfig.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:generated": "npx --yes openapi-typescript@7.13.0 --default-non-nullable=false ./openapi.json -o ./.schema-check.d.ts && diff -q ./src/schema.d.ts ./.schema-check.d.ts && rm ./.schema-check.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.15.32"
  }
}
