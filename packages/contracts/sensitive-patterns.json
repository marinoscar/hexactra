      "shownAs": "••••0659",
      "source": "(?<![\\w•-]|\\d[.,])(?<=\\b(?:accounts?|acct|checking|savings|iban)\\b[^\\d\\n]{0,24}|(?<![\\w&])#[ \\t]?)\\d{6,17}(?![\\w•-]|[.,]\\d)",
      "flags": "gi",
      "check": null,
      "mask": {
        "kind": "last4",
        "prefix": "••••"
      }
    },
    {
      "id": "phone",
      "description": "A phone number: US forms (`(555) 123-4567`, `555-123-4567`, `+1 555 123 4567`) and international forms with a leading `+`",
      "shownAs": "•••-•••-6020",
      "source": "(?<![\\w•+.\\-(]|\\d[.,])(?:\\+?1[ .\\-]?)?(?:\\(\\d{3}\\)[ ]?|\\d{3}[ .\\-])\\d{3}[ .\\-]\\d{4}(?![\\w•-]|[.,]\\d)|(?<![\\w•+])\\+(?=(?:[ .\\-]?\\d){7,15}(?![ .\\-]?\\d))\\d{1,3}(?:[ .\\-]\\d{1,6}){1,6}(?![\\w•-]|[.,]\\d)",
      "flags": "g",
      "check": null,
      "mask": {
        "kind": "last4",
        "prefix": "•••-•••-"
