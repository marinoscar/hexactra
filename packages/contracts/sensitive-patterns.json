      "shownAs": "•••• 4242",
      "source": "(?<![\\w•-]|\\d[.,])(?:\\d{13,19}|\\d{4}([ -])\\d{4}\\1\\d{4}\\1\\d{1,4}(?:\\1\\d{1,3})?|\\d{4}([ -])\\d{6}\\2\\d{4,5})(?![\\w•-]|[.,]\\d)",
      "flags": "g",
