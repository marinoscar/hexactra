      "source": "(?<![A-Za-z0-9])(?:pat_|oat_|ort_|oac_|nod_|hxs_|hxe_|hxh_|whsec_)(?=[A-Za-z0-9_\\-]{0,256}[0-9])[A-Za-z0-9_\\-]{16,512}|\\bBearer[ \\t]{1,4}(?=[A-Za-z0-9._~+/\\-]{0,4096}[0-9])[A-Za-z0-9._~+/\\-]{8,4096}={0,2}|\\beyJ[A-Za-z0-9_\\-]{4,4096}\\.eyJ[A-Za-z0-9_\\-]{4,8192}\\.[A-Za-z0-9_\\-]{0,4096}|(?<![A-Za-z0-9_\\-])(?:sk|rk|pk|key|sk_live|sk_test|rk_live|rk_test|pk_live|pk_test|ghp|gho|ghs|ghu|github_pat|xox[abprs])[-_](?=[A-Za-z0-9_\\-]{0,256}[0-9])[A-Za-z0-9_\\-]{16,512}|\\bAKIA[0-9A-Z]{16}\\b",
      "flags": "g",
      "check": null,
      "mask": {
        "kind": "literal",
        "text": "[redacted token]"
      }
    },
    {
