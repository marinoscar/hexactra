      "source": "\\bhttps?:\\/\\/(?:(?!:\\/\\/)[^\\s?#\"'<>`]){1,2048}[?#][^\\s\"'<>`]{0,4096}[^\\s\"'<>`.,;:!?)\\]]",
      "flags": "gi",
      "check": null,
      "mask": {
        "kind": "url"
      }
    },
    {
      "id": "email",
      "description": "An email address",
      "shownAs": "o•••@example.test",
      "source": "(?<![\\w.%+\\-])[A-Za-z0-9][A-Za-z0-9._%+\\-]{0,63}@(?!\\d{1,2}x\\.)(?:[A-Za-z0-9\\-]{1,63}\\.){1,8}[A-Za-z]{2,24}(?![\\w\\-])",
      "flags": "g",
      "check": null,
