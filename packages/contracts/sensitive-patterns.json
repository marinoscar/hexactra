      "shownAs": "•••-••-6789",
      "source": "(?<![\\w•-]|\\d[.,])(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}(?![\\w•-]|[.,]\\d)|(?<![\\w•-]|\\d[.,])(?<=\\b(?:ssn|social security(?: number| no\\.?| #)?)[\\s:#.\\-]{1,4})\\d{9}(?![\\w•-]|[.,]\\d)",
